{
  "name": "kingmast",
  "version": "0.0.6",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "concurrently -n hmi,api \"pnpm --filter @kingmast/hmi dev\" \"pnpm --filter @kingmast/risk-engine dev\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "safety:boundary": "node scripts/safety-boundary-check.mjs"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.18"
    }
  },
  "devDependencies": {"concurrently":"^9.2.1","typescript":"^5.9.2"}
}
