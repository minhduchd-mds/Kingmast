{
  "name": "kingmast",
  "version": "0.0.6",
  "private": true,
  "packageManager": "pnpm@10.34.0",
  "scripts": {
    "dev": "concurrently -n hmi,api \"pnpm --filter @kingmast/hmi dev\" \"pnpm --filter @kingmast/risk-engine dev\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "sil:replay": "pnpm --filter @kingmast/risk-engine exec tsx src/sil-replay-cli.ts",
    "performance:risk-evidence": "pnpm --filter @kingmast/risk-engine exec tsx src/performance-evidence-cli.ts",
    "performance:host-soak": "pnpm --filter @kingmast/risk-engine exec tsx src/host-soak-evidence-cli.ts",
    "realtime:recovery-evidence": "pnpm --filter @kingmast/risk-engine exec tsx src/realtime-recovery-evidence-cli.ts",
    "realtime:integration-evidence": "pnpm --filter @kingmast/risk-engine exec tsx src/realtime-integration-evidence-cli.ts",
    "realtime:policy": "node scripts/realtime-resilience-policy-check.mjs",
    "hmi:design-system": "pnpm --filter @kingmast/hmi design-system:check",
    "toolchain:hmi-policy": "node scripts/hmi-toolchain-policy-check.mjs",
    "hil:evidence": "node scripts/hil-evidence-check.mjs",
    "hil:package-check": "node scripts/hil-evidence-package-check.mjs",
    "boot:evidence": "node scripts/boot-security-evidence-check.mjs",
    "skills:validate": "node scripts/validate-agent-skills.mjs",
    "safety:boundary": "node scripts/safety-boundary-check.mjs",
    "architecture:boundary": "node scripts/architecture-boundary-check.mjs",
    "security:secrets": "node scripts/secret-scan.mjs",
    "security:config-auth": "node scripts/configuration-auth-policy-check.mjs",
    "security:provider-auth": "node scripts/provider-identity-policy-check.mjs",
    "security:workflow-policy": "node scripts/workflow-security-policy-check.mjs",
    "security:audit": "pnpm audit --audit-level=moderate",
    "audit:integrity": "node scripts/audit-integrity-policy-check.mjs",
    "ota:recovery-policy": "node scripts/update-recovery-policy-check.mjs",
    "firmware:policy": "node scripts/firmware-security-policy-check.mjs",
    "firmware:evidence": "node scripts/firmware-trust-evidence-check.mjs",
    "release:identity-policy": "node scripts/release-identity-policy-check.mjs",
    "supplychain:sbom": "node scripts/generate-sbom.mjs",
    "supplychain:provenance": "node scripts/generate-build-provenance.mjs",
    "evidence:anchor": "node scripts/generate-evidence-anchor.mjs",
    "evidence:anchor-verify": "node scripts/verify-evidence-anchor.mjs",
    "evidence:signing-selftest": "node scripts/evidence-signing-selftest.mjs",
    "evidence:timestamp-verify": "node scripts/verify-external-evidence-timestamp.mjs",
    "evidence:validate": "node scripts/engineering-evidence-check.mjs",
    "evidence:oem-traceability": "node scripts/expert-oem-traceability-check.mjs",
    "evidence:hmi-human-factors": "pnpm --filter @kingmast/hmi exec node scripts/human-factors-evidence.mjs",
    "vercel:policy": "node scripts/vercel-deploy-policy-check.mjs"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  }
}
