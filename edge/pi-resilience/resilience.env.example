# KINGMAST OS resilience defaults for Raspberry Pi 5 research builds.
# Copy to /etc/kingmast/resilience.env and adjust during image provisioning.

KINGMAST_RESILIENCE_STATE_DIR=/var/lib/kingmast/resilience
KINGMAST_BOOT_STATE=/var/lib/kingmast/recovery/boot-state.json
KINGMAST_HISTORY_STORAGE_DIR=/mnt/kingmast-sd/history
KINGMAST_REQUIRED_SERVICES=kingmast-pi-history.service

# Health agent: 5s checks, three consecutive critical failures before recovery request.
KINGMAST_HEALTH_INTERVAL_SEC=5
KINGMAST_FAILURE_THRESHOLD=3
# Candidate must remain healthy for 12 cycles = 60 seconds before it is eligible for acceptance.
KINGMAST_CANDIDATE_HEALTH_CYCLES=12

# Reference A/B boot partitions. Root filesystems should remain separate from persistent data.
KINGMAST_SLOT_A_PARTITION=2
KINGMAST_SLOT_B_PARTITION=3

# Prevent repeated recovery requests from creating a reboot storm.
KINGMAST_RECOVERY_COOLDOWN_SEC=120
KINGMAST_RESILIENCE_USER=kingmast
