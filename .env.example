DATABASE_URL=postgresql://kingmast:kingmast@localhost:5432/kingmast
PORT=4000
HOST=127.0.0.1
HMI_ORIGIN=http://localhost:3000

# Local-only bench mode. The server refuses this flag when HOST is not loopback.
KINGMAST_ALLOW_INSECURE_LOCAL_DEV=1
KINGMAST_EDGE_TOKEN=

# Dedicated least-privilege credential for configuration writes such as POST /v3/geofences.
# Use a random value of at least 32 characters. Keep it server/operator-side only; never expose via NEXT_PUBLIC_*.
# In non-loopback deployments, missing/invalid configuration auth fails closed for configuration writes.
KINGMAST_CONFIG_TOKEN=

# Transitional per-device identity for consolidated edge packets and sensor/assist ingress.
# Supported records: hmac-sha256 (shared per-device secret) or ed25519 (server stores only publicKeyPem).
# Set KINGMAST_REQUIRE_DEVICE_AUTH=1 to disable shared EDGE_TOKEN fallback for /v3/edge/frame,
# /v3/perception/camera, /v3/perception/radar, /v3/edge/gnss and /v3/assist/{lane,dms,surround}.
# Keep all registry material server-side; never expose via NEXT_PUBLIC_*.
# HMAC example:
# {"edge-1":[{"keyId":"2026-09-hmac-a","algorithm":"hmac-sha256","secret":"replace-with-32-plus-random-characters","state":"active"}]}
# Ed25519 example shape (PEM omitted here):
# {"edge-1":[{"keyId":"2026-09-ed-a","algorithm":"ed25519","publicKeyPem":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----","state":"active"}]}
KINGMAST_REQUIRE_DEVICE_AUTH=0
KINGMAST_DEVICE_KEYS_JSON={}

# Camera publisher migration example (publisher environment only; never browser-visible):
# KINGMAST_DEVICE_ID=edge-camera-01
# KINGMAST_DEVICE_KEY_ID=2026-09-hmac-a
# KINGMAST_DEVICE_SECRET=replace-with-32-plus-random-characters

# External provider identity is a separate trust domain from vehicle telemetry.
# Set strict mode to remove EDGE_TOKEN fallback from provider-owned camera/connected-road/V2X routes.
# Records support scoped hmac-sha256 or ed25519 credentials, rotation/revocation and validity windows.
# Example shape (do not reuse device credentials):
# {"provider-a":[{"keyId":"2026-09-ed-a","algorithm":"ed25519","publicKeyPem":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----","scopes":["road-context:cameras","connected-road:provider"],"state":"active"}]}
KINGMAST_REQUIRE_PROVIDER_AUTH=0
KINGMAST_PROVIDER_KEYS_JSON={}

# mTLS certificate lifecycle metadata scaffold only. The application does not trust arbitrary
# client-certificate HTTP headers; production mTLS must terminate at a trusted gateway/service mesh.
# Values are providerId -> 1..4 certificate metadata records with SHA-256 fingerprint, scopes,
# validity window and active/revoked state. No certificate private keys belong here.
KINGMAST_PROVIDER_CERTIFICATES_JSON={}

# Server-only secret used to mint/verify short-lived HMAC viewer sessions.
# Use a random 128-bit+ value. Never expose this as NEXT_PUBLIC_* or place it in browser code.
KINGMAST_VIEWER_TOKEN=

# Optional parent-domain cookie scope when HMI and gateway use sibling hosts.
# Example: .kingmast.example.com. Leave blank for same-host/local deployments.
# Browser WebSocket auth requires HMI and gateway to share a cookie-capable site/domain.
KINGMAST_VIEWER_COOKIE_DOMAIN=

# Optional bounded local append-only evidence journal for research/bench deployments.
# It stores only EdgeEventRecord metadata (no raw camera/radar frames or cabin video).
# Warning computation remains independent from disk I/O. Production intent still requires
# protected durable storage, retention policy, backup/restore and integrity review.
KINGMAST_AUDIT_JOURNAL_PATH=
KINGMAST_AUDIT_MAX_BYTES=5242880
KINGMAST_AUDIT_MAX_FILES=3

NEXT_PUBLIC_KINGMAST_API_URL=http://localhost:4000
NEXT_PUBLIC_KINGMAST_WS_URL=ws://localhost:4000/v3/stream
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_RASTER_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Map/navigation providers. Production deployments should use approved providers with an SLA.
OVERPASS_URL=https://overpass-api.de/api/interpreter
ROUTING_BASE_URL=https://router.project-osrm.org
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
KINGMAST_CAMERA_PROVIDER_URLS=
KINGMAST_CAMERA_PROVIDER_TOKEN=
KINGMAST_UPSTREAM_CONCURRENCY=6

# Bounded in-memory abuse/replay state. These limits protect a single process from unbounded key growth;
# production Internet deployments should also use an edge gateway/WAF or distributed limiter.
KINGMAST_RATE_LIMIT_MAX_KEYS=2048
KINGMAST_SPEED_SIGN_REPLAY_MAX_KEYS=4096

# Legacy migration-only JSON map of providerId -> HMAC secret for V2X feeds.
# Strict provider-auth mode does not treat this as authoritative. Migrate to KINGMAST_PROVIDER_KEYS_JSON.
KINGMAST_V2X_PROVIDER_KEYS_JSON={}

# Optional detached evidence signing is performed outside the repository/normal CI identity.
# Private signing key must come from an isolated signer/HSM/KMS and must never be committed.
# KINGMAST_EVIDENCE_SIGNING_KEY_ID=release-evidence-2026-a
# KINGMAST_EVIDENCE_SIGNING_PRIVATE_KEY_PEM=
# KINGMAST_EVIDENCE_SIGNING_PUBLIC_KEY_PEM=
