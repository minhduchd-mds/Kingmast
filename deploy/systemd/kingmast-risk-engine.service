[Unit]
Description=KINGMAST Risk Engine (read-only vehicle intelligence)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kingmast-risk
Group=kingmast-risk
WorkingDirectory=/opt/kingmast/services/risk-engine
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4000
Environment=KINGMAST_AUDIT_JOURNAL_PATH=/var/lib/kingmast-risk/audit.ndjson
EnvironmentFile=-/etc/kingmast/risk-engine.env
ExecStart=/usr/bin/node /opt/kingmast/services/risk-engine/dist/server.js
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
StateDirectory=kingmast-risk
LogsDirectory=kingmast-risk

# Risk analysis never needs direct CAN/serial/GPIO device access.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
DevicePolicy=closed
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any
SocketBindAllow=tcp:4000
UMask=0077
ReadWritePaths=/var/lib/kingmast-risk /var/log/kingmast-risk

[Install]
WantedBy=multi-user.target
