# KINGMAST production security envelope
# Copy values into the deployment secret/environment manager. Do not commit populated secrets.

# Outer envelope is fail-closed. Keep enabled in every non-test deployment.
KINGMAST_SECURITY_ENVELOPE_ENABLED=true
KINGMAST_RUNTIME_MODE=normal
KINGMAST_EMERGENCY_LOCKDOWN=false

# Public hosted navigation is authenticated by default.
KINGMAST_NAV_AUTH_REQUIRED=true
# 32+ random characters. Server/gateway only; never NEXT_PUBLIC_*.
KINGMAST_NAV_CAPABILITY_SECRET=
KINGMAST_NAV_CAPABILITY_TTL_SECONDS=120
KINGMAST_NAV_RATE_LIMIT_PER_MINUTE=5
KINGMAST_NAV_RATE_LIMIT_PER_HOUR=60

# Optional vehicle-computer broker. OFF by default. Enable only when the HMI service
# is physically/network-bound to loopback (127.0.0.1) on the vehicle computer.
# It mints short-lived one-time navigation capabilities without exposing the master secret.
KINGMAST_NAV_LOOPBACK_BROKER_ENABLED=false

# Community-safe default: paid providers are OFF even if a credential exists.
KINGMAST_PAID_ROUTING_ENABLED=false
KINGMAST_NAV_DAILY_PAID_LIMIT=500
KINGMAST_NAV_KILL_SWITCH=false

# Outbound egress firewall. Exact hostnames only; no schemes, paths or wildcards.
# Built-in approved hosts already include Google Routes, Mapbox, public OSRM,
# Nominatim, OpenAI TTS and ElevenLabs TTS. Add only reviewed custom providers.
KINGMAST_OUTBOUND_KILL_SWITCH=false
KINGMAST_OUTBOUND_ALLOWLIST=

# No generic relay / command / executable distribution surfaces.
KINGMAST_PUBLIC_PROXY_ENABLED=false
KINGMAST_REMOTE_EXEC_ENABLED=false
KINGMAST_EXTERNAL_BINARY_DOWNLOAD=false
KINGMAST_UNSIGNED_UPDATE_ALLOWED=false

# Optional BYOK credentials. Keep server-side only.
GOOGLE_ROUTES_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Local community fallback providers.
ROUTING_BASE_URL=https://router.project-osrm.org
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org

# IMPORTANT:
# KINGMAST_ALLOW_INSECURE_LOCAL_DEV may be used only for local development.
# The Security Envelope ignores that bypass when NODE_ENV=production.
# Production custom Assistant/TTS/OSRM/geocoder endpoints must use HTTPS and their
# exact hostname must be present in KINGMAST_OUTBOUND_ALLOWLIST.
