    {"id":"HIL-004","requiredRoles":["bench-controller","surround-camera","time-sync","bench-display"],"requiredProvisionTargets":["vehicle-computer-aarch64","surround-camera-set","display-primary"],"requiredCalibration":["surround-camera-set"],"stimulus":"surround sync/calibration degradation","expectedBoundary":"degrade surround health/visualization"},
    {"id":"HIL-005","requiredRoles":["bench-controller"],"requiredProvisionTargets":["vehicle-computer-aarch64"],"requiredCalibration":[],"stimulus":"tampered or revoked device identity","expectedBoundary":"reject untrusted device input"},
